generator client {
  provider = "prisma-client"
  output   = "../../generate/tenant"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

enum AttendanceMethod {
  MANUAL
  QR_CODE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Member {
  id                String         @id @default(uuid())
  globalMemberId    String?
  memberCode        String         @unique
  firstName         String
  lastName          String
  email             String?
  phone             String         @unique
  gender            Gender         @default(MALE)
  dob               DateTime?
  bloodGroup        String?
  emergencyPhone    String?
  emergencyName     String?
  address           String?
  avatar            String?
  status            MemberStatus   @default(ACTIVE)
  joinedDate        DateTime       @default(now())
  notes             String?        @db.Text
  assignedTrainerId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedTrainer   Trainer?       @relation(fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  subscriptions     Subscription[]
  attendances       Attendance[]
  payments          Payment[]

  @@index([status])
  @@index([phone])
  @@index([globalMemberId])
  @@index([assignedTrainerId])
}

model Trainer {
  id             String        @id @default(uuid())
  userId         String?       @unique
  name           String
  email          String?
  phone          String        @unique
  specialization String?
  bio            String?
  avatar         String?
  status         TrainerStatus @default(ACTIVE)
  joinedDate     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignedMembers Member[]

  @@index([status])
  @@index([userId])
}

model MembershipPlan {
  id             String         @id @default(uuid())
  name           String
  description    String?
  durationMonths Int            @default(1)
  price          Decimal        @db.Decimal(10, 2)
  admissionFee   Decimal        @default(0) @db.Decimal(10, 2)
  taxRate        Decimal        @default(0) @db.Decimal(5, 2)
  features       Json?          @default("[]")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subscriptions  Subscription[]

  @@index([isActive])
}

model Subscription {
  id             String             @id @default(uuid())
  memberId       String
  planId         String
  startDate      DateTime
  endDate        DateTime
  status         SubscriptionStatus @default(ACTIVE)
  totalAmount    Decimal            @db.Decimal(10, 2)
  discountAmount Decimal            @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal            @default(0) @db.Decimal(10, 2)
  balanceAmount  Decimal            @default(0) @db.Decimal(10, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan           MembershipPlan     @relation(fields: [planId], references: [id])
  payments       Payment[]

  @@index([memberId])
  @@index([planId])
  @@index([status, endDate])
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String
  date      DateTime         @default(now())
  checkIn   DateTime         @default(now())
  checkOut  DateTime?
  method    AttendanceMethod @default(MANUAL)
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())

  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@index([date])
}

model Payment {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  memberId         String
  subscriptionId   String?
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(CASH)
  status           PaymentStatus @default(COMPLETED)
  transactionRef   String?
  paymentDate      DateTime      @default(now())
  notes            String?
  recordedByUserId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([subscriptionId])
  @@index([paymentDate])
}

model GymSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
