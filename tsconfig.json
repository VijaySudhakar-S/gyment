{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*", "./*"],
      "@adminDB/index": ["./generate/admin/index"],
      "@tenantDB/index": ["./generate/tenant/index"],
      "@adminDB/*": ["./generate/admin/*"],
      "@tenantDB/*": ["./generate/tenant/*"],
      "@backend/*": ["./src/backend/*"],
      "@services/*": ["./src/backend/services/*"],
      "@controller/*": ["./src/backend/controller/*"],
      "@helpers/*": ["./src/backend/helpers/*"],
      "@config/*": ["./src/backend/config/*"],
      "@loaders/*": ["./src/backend/loaders/*"],
      "@middlewares/*": ["./src/backend/middlewares/*"],
      "@interface/*": ["./src/backend/interface/*"],
      "@api/*": ["./src/backend/api/*"],
      "@errors/*": ["./src/backend/api/errors/*"],
      "@responseMessages/*": ["./src/backend/responseMessages/*"],
      "@constants/*": ["./src/backend/constants/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
