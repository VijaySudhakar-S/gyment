{
  "name": "gyment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate": "npm run generate:admin && npm run generate:tenant",
    "generate:admin": "npx prisma generate --config prisma.config.ts",
    "generate:tenant": "npx prisma generate --config prisma.tenant.config.ts",
    "migrate": "npx prisma migrate dev --config prisma.config.ts",
    "migrate:admin": "npx prisma migrate dev --config prisma.config.ts",
    "migrate:tenant": "npx prisma migrate dev --config prisma.tenant.config.ts",
    "seed": "tsx prisma/seed.ts",
    "backend": "tsx src/backend/app.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
