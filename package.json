    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "celebrate": "^16.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
